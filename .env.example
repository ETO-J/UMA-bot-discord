# ===== 环境模式 =====
ENVIRONMENT=dev
DRIVER=~httpx+~websockets

# ===== API Keys =====
# DeepSeek API (chat / reasoner)
AICHATKEY1=sk-your-deepseek-key

# Bing Search API (via bocha.cn)
BINGSEARCHKEY1=sk-your-bing-key

# Doubao Vision API (image analysis)
VIRSIONKEY1=your-doubao-vision-key

# SauceNAO (anime image search)
SAUCENAO_API_KEY=your-saucenao-key

# Pixiv Refresh Token
PIXIV_REFRESH_TOKEN=your-pixiv-token

# ===== Discord Bot =====
DISCORD_BOTS='
[
  {
    "token": "your-discord-bot-token",
    "intent": {
      "guild_messages": true,
      "direct_messages": true,
      "message_content": true
    },
    "application_commands": {"*": ["*"]}
  }
]
'
DISCORDKEY1=your-discord-bot-token

# ===== Admin =====
ADMIN1=your-discord-user-id
SUPERUSER=your-discord-user-id

# ===== Command Prefix =====
COMMAND_START=["!", ""]

# ===== ComfyUI =====
COMFYUI_URL=http://127.0.0.1:8000
COMFYUI_OUTPUT_DIR=C:\path\to\ComfyUI\output
LORA_BASE_PATH=C:\path\to\ComfyUI\models\loras
IMAGE_SAVE_PATH=C:\path\to\saved\images
# Asset library storage root (private + published snapshots)
ASSET_LIBRARY_ROOT=C:\path\to\asset-library

# ===== WebUI Discord OAuth (Cloudflare Tunnel) =====
# Create an OAuth2 app at https://discord.com/developers/applications
# Use the SAME application as your bot, or create a new one.
# Redirect URL: https://your-tunnel-domain/api/auth/callback
# For local dev: http://127.0.0.1:8000/api/auth/callback
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
# If you are in China and cannot connect to Discord directly, set your proxy:
# DISCORD_PROXY=http://127.0.0.1:7890
JWT_SECRET=generate-a-random-secret-string-here
# Set to true to require login for all endpoints
AUTH_REQUIRED=false

# ===== Public asset library -> Discord channel sync =====
# Reuses the bot token from the Discord Bot section above. The webapp reads the
# `DiscordToken` env key (e.g. DiscordToken=your-discord-bot-token).
# When a user publishes an asset, the bot posts an announcement in the channel;
# unpublishing silently deletes that message.
# Leave ASSET_PUBLISH_CHANNEL_ID empty to disable the sync.
ASSET_PUBLISH_GUILD_ID=1525712372306677991
ASSET_PUBLISH_CHANNEL_ID=1546739758871609386
# Max attachment size (MB) for the announcement; larger media is posted as
# thumbnail-only (or text-only) instead of failing.
ASSET_DISCORD_MAX_UPLOAD_MB=10

# ===== Optional: Ollama (local LLM) =====
# OLLAMA_HOST=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=glm-4.7-flash:latest
